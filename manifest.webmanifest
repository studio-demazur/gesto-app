{
 "name": "Gesto di Lab DeMazur",
 "short_name": "Gesto",
 "description": "Schizzo e CAD per la penna. Studio DeMazur.",
 "lang": "it",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone"
 ],
 "orientation": "any",
 "background_color": "#264E5D",
 "theme_color": "#264E5D",
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/vnd.demazur.dmz": [
     ".dmz"
    ]
   },
   "icons": [
    {
     "src": "icone/icon-192.png?r=2",
     "sizes": "192x192",
     "type": "image/png"
    }
   ],
   "launch_type": "single-client"
  }
 ],
 "icons": [
  {
   "src": "icone/icon-192.png?r=2",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icone/icon-512.png?r=2",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icone/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}